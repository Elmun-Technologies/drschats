# Shopflow platform integration
# Catalogue source: built-in by default. Only CATALOG_SOURCE=shopflow switches to the
# external Shopflow API (SHOPFLOW_MODE is no longer read).
# CATALOG_SOURCE=shopflow
SHOPFLOW_API_URL=https://api.shopflow.example/v1
SHOPFLOW_API_KEY=

# Public site URL (used for canonical, sitemap, robots, OG, hreflang, email
# links). Must be the production origin WITH the www host that the site is
# served on — the code falls back to https://www.govita.uz, so a deployment
# that forgets this variable still publishes the right canonical tags.
# Also point the apex domain at www in the hosting dashboard, otherwise the
# same page answers on two hosts and Google splits the signals.
NEXT_PUBLIC_SITE_URL=https://www.govita.uz

# Go Vita accounts/orders API (see backend/). Leave blank and the account area
# is not rendered at all — no /account route, no header entry, nothing to sign
# in to. Set it and the customer cabinet turns on.
NEXT_PUBLIC_API_URL=

# Sanity CMS (leave blank to use built-in static content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=
# /studio is off in production unless this is "on" AND a real project id is set
# above. It is always available in development. A Studio pointed at a
# placeholder project renders a login screen for a project that does not exist,
# so both are required rather than one. See src/app/studio/layout.tsx.
SANITY_STUDIO_ENABLED=

# Analytics / context-ads (optional — leave blank to disable)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Content-Security-Policy. The policy is *derived*: each analytics origin above
# appears in it only once its ID is set, and the account API origin only once
# NEXT_PUBLIC_API_URL is set — so there is nothing to keep in sync here.
#   report-only (default)  send the header, block nothing, violations in DevTools
#   enforce                block for real
#   off                    send no CSP header at all
# Read at BUILD time: the policy is baked into the routes manifest, so changing
# this on a running server does nothing until the next build. The server says so
# at boot if the two disagree (src/instrumentation.ts). On Vercel every deploy
# rebuilds, which is why this is safe to treat as an ordinary variable there.
# Ship report-only first. GTM, Meta Pixel and Yandex Metrika each inject further
# resources of their own at runtime and none can be enumerated from the build, so
# enforcement should follow a few quiet days in the console with the real tags
# loaded, not precede them. See src/lib/security/csp.ts.
CSP_MODE=report-only

# Optional. Where the browser posts violation reports. Left unset, reports are
# only visible in DevTools — which is enough to watch a report-only policy.
# Enable only if you have an endpoint that accepts unauthenticated POSTs from
# every visitor (Sentry, a collector) and is rate-limited.
CSP_REPORT_URI=

# Email (Resend). Without RESEND_API_KEY every send is logged and skipped, so
# checkout never breaks on a missing mail provider — but nobody receives
# anything either. The domain also needs SPF, DKIM and DMARC records or the
# mail lands in spam. See docs/MARKETING.md.
RESEND_API_KEY=
EMAIL_FROM=Go Vita <no-reply@govita.uz>
EMAIL_REPLY_TO=info@govita.uz
# Signs opt-in, unsubscribe, preference and account-verification links.
# Required in production: the app refuses to start without it.
EMAIL_TOKEN_SECRET=

# Reminder queue. CRON_SECRET guards /api/cron/marketing (unset = endpoint
# stays closed); MARKETING_API_KEY must match the same value in the backend.
CRON_SECRET=
MARKETING_API_KEY=

# Telegram — operator group for new orders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The customer-facing bot. Sign-in codes already populate each customer's
# chat id; without this name the Telegram channel is hidden on /profile.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Sample social proof — the built-in reviews, star ratings and "just bought"
# toasts. Off unless set to "on", because none of it describes a real customer.
# Turn it on for a demo deployment only. See docs/QOLGAN-ISHLAR.md.
NEXT_PUBLIC_SAMPLE_SOCIAL_PROOF=

# Demo account cabinet. With NEXT_PUBLIC_API_URL blank the account area serves
# built-in mock data: any phone number and any code "sign in" and show someone
# else's orders. That is fine for walking a client through the UI and wrong on
# a live shop, so /account 404s unless this is "on" or the real API is set.
# See src/lib/config/demo.ts.
NEXT_PUBLIC_ACCOUNT_DEMO=
