# python backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/*.db

# generated by scripts/assets/ingest-product-images.mjs
/scripts/assets/ingest-report.json

# Photo dumps arrive as archives and are extracted by
# scripts/assets/ingest-product-images.mjs, which reads images only — it has
# never looked at an archive. They used to be committed under public/products,
# which made 46 MB of supplier photo dumps downloadable by anyone at
# /products/<name>.rar and shipped that weight in every deploy. The archive is
# a delivery vehicle, not an asset: keep it out of the repo and out of public/.
*.rar
*.zip
*.7z

/public/products/inbox/
!/public/products/inbox/.gitkeep
