# Matches the defaults in the repo-root docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://govita:govita_dev@postgres:5432/govita

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production — the app refuses to start with the placeholder.
JWT_SECRET=dev-only-change-me

ENVIRONMENT=development

# Comma-separated storefront origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Telegram sign-in ---------------------------------------------------
# Codes are delivered by a bot, so all three are needed before anyone can log
# in. Create the bot with @BotFather; the username is the one after the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Telegram echoes this back in X-Telegram-Bot-Api-Secret-Token and it is the
# only thing guarding the webhook. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Register the webhook once the API is reachable over HTTPS:
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#        -d url=https://api.govita.uz/api/v1/telegram/webhook \
#        -d secret_token=<TELEGRAM_WEBHOOK_SECRET>

# Sign-in codes. Defaults are sensible; override only with a reason.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Development only: log codes instead of needing a bot. The app refuses to
# start with this on in production.
OTP_DEBUG_ECHO=false
