# Matches the defaults in the repo-root docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://govita:govita_dev@postgres:5432/govita

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production — the app refuses to start with the placeholder.
JWT_SECRET=dev-only-change-me

ENVIRONMENT=development

# Comma-separated storefront origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000
