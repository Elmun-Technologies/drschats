# Serverda: /opt/govita/.env  (chmod 600, gitga TUSHMAYDI)
# setup.sh ichki kalitlarni o'zi yaratadi. Qolganini qo'lda to'ldiring.
# Ma'nosi: CLAUDE.md → Environment Variables, docs/DEPLOY-HETZNER.md

SITE_DOMAIN=govita.uz
NEXT_PUBLIC_SITE_URL=https://www.govita.uz
BACKUP_KEEP_DAYS=14

# --- setup.sh yaratadi; BIR MARTA qo'yiladi, keyin O'ZGARTIRILMAYDI ---
POSTGRES_PASSWORD=
ADMIN_SESSION_SECRET=
EMAIL_TOKEN_SECRET=
INTEGRATION_ENCRYPTION_KEY=
CRON_SECRET=
MESSAGE_LINK_SECRET=
LOYALTY_SECRET=
RATE_LIMIT_SALT=

# --- Birinchi admin: /admin/setup?token=… ; admin yaratilgach qatorni o'chiring ---
ADMIN_SETUP_TOKEN=

# --- Operator Telegram (buyurtma xabarlari) — live'da majburiy ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rasm yuklash: Hetzner Object Storage (S3) ---
AWS_ENDPOINT_URL_S3=https://fsn1.your-objectstorage.com
AWS_REGION=fsn1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=
# Rasmlarning ochiq manzili (build'da ham beriladi — GitHub vars STORAGE_PUBLIC_URL)
STORAGE_PUBLIC_URL=

# --- SMS (Eskiz) — yoki /admin/integrations ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# --- Email (ixtiyoriy) ---
RESEND_API_KEY=
EMAIL_FROM=Go Vita <no-reply@govita.uz>
EMAIL_REPLY_TO=info@govita.uz

# --- Telegram klub boti (ixtiyoriy) ---
BOT_API_KEY=
TELEGRAM_CLUB_BOT_TOKEN=

# --- Qidiruv tizimlari (ixtiyoriy; /admin/integrations ham bor) ---
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
